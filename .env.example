# Server-side only. Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Defaults to gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-flash-lite-latest

# Public canonical origin used by metadata and sitemap (no secret).
# NEXT_PUBLIC_SITE_URL=https://your-production-url.vercel.app

# Air quality, weather and geocoding need no key.
